[
  {
    "label": "cargo build: frequency_analysis_limits",
    "command": "cargo",
    "args": [
      "build",
      "--package",
      "frequency_analysis_limits",
      "--bin",
      "frequency_analysis_limits",
    ],
    "env": {
      "RUSTFLAGS": "-l protobuf",
    },
  },
  {
    "label": "cargo run",
    "command": "cargo",
    "args": [
      "run",
      "--package",
      "frequency_analysis_limits",
      "--bin",
      "frequency_analysis_limits",
      "--",
      "--name",
      "spitz",
      "--dir-path",
      "databases/",
      "--plot",
      "--t",
      "4",
      "--post",
    ],
    "env": {
      "RUSTFLAGS": "-l protobuf",
    },
  },
  {
    "label": "cargo run (plotting only)",
    "command": "cargo",
    "args": [
      "run",
      "--package",
      "frequency_analysis_limits",
      "--bin",
      "frequency_analysis_limits",
      "--",
      "--name",
      "spitz",
      "--dir-path",
      "databases/",
      "--plot",
      "--t",
      "4",
      "--post",
      "--skip-lama",
    ],
    "env": {
      "RUSTFLAGS": "-l protobuf",
    },
  },
]
