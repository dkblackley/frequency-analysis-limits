[
  {
    "label": "Debug frequency_analysis_limits",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/frequency_analysis_limits",
    "args": [
      "--name",
      "cali",
      "--dir-path",
      "databases/50x50",
      "--plot",
      "--t",
      "2",
      "--post",
    ],
    "env": {
      "RUSTFLAGS": "-l protobuf",
    },
    "build": {
      "command": "cargo",
      "args": [
        "build",
        "--package",
        "frequency_analysis_limits",
        "--bin",
        "frequency_analysis_limits",
      ],
      "env": {
        "RUSTFLAGS": "-l protobuf",
      },
    },
    "sourceLanguages": ["rust"],
  },
  {
    "label": "Debug end_to_end test",
    "adapter": "GDB",
    "request": "launch",
    "build": {
      "command": "cargo",
      "args": ["test", "--no-run", "--test", "integration"],
    },
    "args": ["end_to_end", "--exact", "--nocapture"],
    "env": {
      "RUSTFLAGS": "-l protobuf",
    },
    "sourceLanguages": ["rust"],
  },

  {
    "label": "Debug frequency_analysis_limits (GDB)",
    "adapter": "gdb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/frequency_analysis_limits",
    "args": [
      "--name",
      "cali",
      "--dir-path",
      "databases/50x50",
      "--plot",
      "--t",
      "2",
      "--post",
    ],
    "env": {
      "RUSTFLAGS": "-l protobuf",
    },
    "build": {
      "command": "cargo",
      "args": [
        "build",
        "--package",
        "frequency_analysis_limits",
        "--bin",
        "frequency_analysis_limits",
      ],
      "env": {
        "RUSTFLAGS": "-l protobuf",
      },
    },
  },
]
