Bootstrap: docker
From: rust:1.77-bookworm

%post
    # Update and install all necessary C++ build tools and bindgen dependencies
    apt-get update
    apt-get install -y \
        cmake \
        clang \
        libclang-dev \
        build-essential \
        protobuf-compiler \
        wget

    # Clean up to keep the container small
    apt-get clean